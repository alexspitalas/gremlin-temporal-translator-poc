<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Suppress noisy Gremlin compilation logs -->
    <logger name="org.apache.tinkerpop.gremlin.groovy.jsr223.GremlinGroovyScriptEngine" level="INFO" />
</configuration>
